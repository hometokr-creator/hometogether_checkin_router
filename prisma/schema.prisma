generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  GUEST
  HOST
}

enum ContractStatus {
  PENDING
  ACTIVE
  ENDED
  CANCELLED
}

enum IdentityLinkStatus {
  ACTIVE
  REVOKED
  CONFLICT
}

enum KakaoReachability {
  NOT_LINKED
  LINKED_NOT_FRIEND
  FRIEND_ACTIVE
  BLOCKED
  DELIVERY_FAILED
  UNKNOWN
}

enum LinkingTokenStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

enum HouseholdEventSource {
  INBOUND
  CHECKIN
  SYSTEM
}

enum IssueStatus {
  REPORTED
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  FOLLOWUP
  CLOSED
  REOPENED
}

enum IssueRoute {
  A
  B
  C
}

enum ActionTicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Household {
  id          String          @id
  members     Member[]
  cycles      ContractCycle[]
  links       ChannelIdentityLink[]
  events      HouseholdEvent[]
  issues      Issue[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  @@map("households")
}

model Member {
  id          String          @id
  householdId String          @map("household_id")
  household   Household       @relation(fields: [householdId], references: [id], onDelete: Restrict)
  role        MemberRole
  links       ChannelIdentityLink[]
  tokens      ChannelLinkingToken[]
  events      HouseholdEvent[]
  issues      Issue[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  @@index([householdId])
  @@map("members")
}

model ContractCycle {
  id          String          @id
  householdId String          @map("household_id")
  household   Household       @relation(fields: [householdId], references: [id], onDelete: Restrict)
  status      ContractStatus
  startsAt    DateTime        @map("starts_at")
  endsAt      DateTime?       @map("ends_at")
  links       ChannelIdentityLink[]
  tokens      ChannelLinkingToken[]
  events      HouseholdEvent[]
  issues      Issue[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  @@index([householdId, status])
  @@map("contract_cycles")
}

model HouseholdEvent {
  id              String               @id @default(cuid())
  householdId     String               @map("household_id")
  contractCycleId String               @map("contract_cycle_id")
  memberId        String?              @map("member_id")
  issueId         String?              @map("issue_id")
  source          HouseholdEventSource
  eventType       String               @map("event_type")
  occurredAt      DateTime             @map("occurred_at")
  payload         Json
  household       Household            @relation(fields: [householdId], references: [id], onDelete: Restrict)
  contractCycle   ContractCycle        @relation(fields: [contractCycleId], references: [id], onDelete: Restrict)
  member          Member?              @relation(fields: [memberId], references: [id], onDelete: SetNull)
  issue           Issue?               @relation(fields: [issueId], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now()) @map("created_at")
  @@index([householdId, occurredAt])
  @@index([contractCycleId, occurredAt])
  @@index([memberId, occurredAt])
  @@index([issueId, occurredAt])
  @@map("household_events")
}

model Issue {
  id                 String            @id @default(cuid())
  householdId        String            @map("household_id")
  contractCycleId    String            @map("contract_cycle_id")
  memberId           String?           @map("member_id")
  status             IssueStatus       @default(REPORTED)
  route              IssueRoute
  intent             String
  domain             String
  severity           String
  urgency            String
  classification     Json
  openedAt           DateTime          @map("opened_at")
  closedAt           DateTime?         @map("closed_at")
  household          Household         @relation(fields: [householdId], references: [id], onDelete: Restrict)
  contractCycle      ContractCycle     @relation(fields: [contractCycleId], references: [id], onDelete: Restrict)
  member             Member?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
  events             HouseholdEvent[]
  tickets            ActionTicket[]
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  @@index([householdId, status, openedAt])
  @@index([contractCycleId, status])
  @@index([memberId, openedAt])
  @@map("issues")
}

model ActionTicket {
  id          String             @id @default(cuid())
  issueId     String             @map("issue_id")
  status      ActionTicketStatus @default(OPEN)
  queue       String
  dueAt       DateTime           @map("due_at")
  assignedTo String?            @map("assigned_to")
  issue       Issue              @relation(fields: [issueId], references: [id], onDelete: Restrict)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  @@index([issueId, status])
  @@index([status, dueAt])
  @@map("action_tickets")
}

model ChannelIdentityLink {
  id                 String             @id @default(cuid())
  provider           String             @default("KAKAO")
  providerUserKeyHash String            @map("provider_user_key_hash")
  memberId           String             @map("member_id")
  householdId        String             @map("household_id")
  contractCycleId    String             @map("contract_cycle_id")
  role               MemberRole
  status             IdentityLinkStatus @default(ACTIVE)
  reachability       KakaoReachability   @default(UNKNOWN)
  verifiedAt         DateTime            @map("verified_at")
  revokedAt          DateTime?           @map("revoked_at")
  member             Member              @relation(fields: [memberId], references: [id], onDelete: Restrict)
  household          Household           @relation(fields: [householdId], references: [id], onDelete: Restrict)
  contractCycle      ContractCycle       @relation(fields: [contractCycleId], references: [id], onDelete: Restrict)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  @@unique([provider, providerUserKeyHash, contractCycleId])
  @@index([memberId, status])
  @@index([householdId, contractCycleId, status])
  @@map("channel_identity_links")
}

model ChannelLinkingToken {
  id              String             @id @default(cuid())
  tokenHash       String             @unique @map("token_hash")
  memberId        String             @map("member_id")
  contractCycleId String             @map("contract_cycle_id")
  status          LinkingTokenStatus @default(ACTIVE)
  expiresAt       DateTime           @map("expires_at")
  usedAt          DateTime?          @map("used_at")
  member          Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  contractCycle   ContractCycle      @relation(fields: [contractCycleId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now()) @map("created_at")
  @@index([memberId, status, expiresAt])
  @@map("channel_linking_tokens")
}

model ProviderEventReceipt {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String   @map("provider_event_id")
  householdId     String?  @map("household_id")
  eventType       String   @map("event_type")
  receivedAt      DateTime @default(now()) @map("received_at")
  @@unique([provider, providerEventId, eventType])
  @@map("provider_event_receipts")
}

model AuditLog {
  id          String   @id @default(cuid())
  event       String
  actorId     String?  @map("actor_id")
  householdId String?  @map("household_id")
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  payload     Json
  createdAt   DateTime @default(now()) @map("created_at")
  @@index([householdId, createdAt])
  @@index([entityType, entityId])
  @@map("checkin_router_audit_logs")
}
