generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  GUEST
  HOST
}

enum ContractStatus {
  PENDING
  ACTIVE
  ENDED
  CANCELLED
}

enum IdentityLinkStatus {
  ACTIVE
  REVOKED
  CONFLICT
}

enum KakaoReachability {
  NOT_LINKED
  LINKED_NOT_FRIEND
  FRIEND_ACTIVE
  BLOCKED
  DELIVERY_FAILED
  UNKNOWN
}

enum LinkingTokenStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

enum HouseholdEventSource {
  INBOUND
  CHECKIN
  SYSTEM
}

enum IssueStatus {
  REPORTED
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  FOLLOWUP
  CLOSED
  REOPENED
}

enum IssueRoute {
  A
  B
  C
}

enum ActionTicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ContractDocumentStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum ContractClauseStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum ModelRunStatus {
  SUCCEEDED
  FAILED
  FALLBACK
}

enum ConversationChannel {
  KAKAO
  WEB_DEMO
}

enum ConversationStatus {
  ACTIVE
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageKind {
  TEXT
  QUICK_REPLY
  SYSTEM
  STATUS_CARD
}

enum InformationAccessLevel {
  A
  B
  C
}

enum StructuredRecordStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum PaymentScheduleStatus {
  SCHEDULED
  PAID
  OVERDUE
  WAIVED
}

enum KnowledgeKind {
  RULE
  ROOM
  INVENTORY
  CONTACT_POLICY
}

enum FlowType {
  CHECKIN
  ISSUE_INTAKE
  FACILITY_TRIAGE
  MOVE_OUT
  EMERGENCY_CONFIRMATION
}

enum FlowStatus {
  IN_PROGRESS
  WAITING_USER
  WAITING_OPERATOR
  COMPLETED
  CANCELLED
  EXPIRED
}

enum CheckinStage {
  D3
  W2
  MONTHLY
  EXIT_D30
}

enum CheckinScheduleStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CheckinDisposition {
  OK
  NEEDS_CLASSIFICATION
  NEEDS_REVIEW
  EMERGENCY
}

model Household {
  id          String          @id
  canonicalHomeId String?     @unique @db.Uuid @map("canonical_home_id")
  members     Member[]
  cycles      ContractCycle[]
  links       ChannelIdentityLink[]
  events      HouseholdEvent[]
  issues      Issue[]
  conversations Conversation[]
  knowledgeRecords KnowledgeRecord[]
  flows       FlowInstance[]
  checkinSchedules CheckinSchedule[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  @@map("households")
}

model Member {
  id          String          @id
  canonicalProfileId String?  @db.Uuid @map("canonical_profile_id")
  householdId String          @map("household_id")
  household   Household       @relation(fields: [householdId], references: [id], onDelete: Restrict)
  role        MemberRole
  links       ChannelIdentityLink[]
  tokens      ChannelLinkingToken[]
  events      HouseholdEvent[]
  issues      Issue[]
  conversations Conversation[]
  flows       FlowInstance[]
  checkinSchedules CheckinSchedule[]
  checkinResponses CheckinResponse[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  @@index([householdId])
  @@unique([canonicalProfileId, householdId])
  @@map("members")
}

model ContractCycle {
  id          String          @id
  canonicalMatchId String?    @unique @db.Uuid @map("canonical_match_id")
  householdId String          @map("household_id")
  household   Household       @relation(fields: [householdId], references: [id], onDelete: Restrict)
  status      ContractStatus
  startsAt    DateTime        @map("starts_at")
  endsAt      DateTime?       @map("ends_at")
  links       ChannelIdentityLink[]
  tokens      ChannelLinkingToken[]
  events      HouseholdEvent[]
  issues      Issue[]
  conversations Conversation[]
  financialTerms ContractFinancialTerms[]
  paymentSchedules PaymentSchedule[]
  knowledgeRecords KnowledgeRecord[]
  flows       FlowInstance[]
  checkinSchedules CheckinSchedule[]
  contractDocuments ContractDocument[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  @@index([householdId, status])
  @@map("contract_cycles")
}

model ContractDocument {
  id              String                 @id
  contractCycleId String                 @map("contract_cycle_id")
  title           String
  version         Int
  isSynthetic     Boolean                @default(true) @map("is_synthetic")
  status          ContractDocumentStatus @default(DRAFT)
  contractCycle   ContractCycle          @relation(fields: [contractCycleId], references: [id], onDelete: Restrict)
  clauses         ContractClause[]
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  @@unique([contractCycleId, version])
  @@index([contractCycleId, status])
  @@map("demo_contracts")
}

model ContractClause {
  id                 String               @id
  contractDocumentId String               @map("contract_document_id")
  domain             String
  clauseNumber       String               @map("clause_number")
  text               String
  effectiveFrom      DateTime             @map("effective_from")
  effectiveTo        DateTime?            @map("effective_to")
  status             ContractClauseStatus @default(DRAFT)
  contractDocument   ContractDocument     @relation(fields: [contractDocumentId], references: [id], onDelete: Restrict)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  @@index([contractDocumentId, domain, status])
  @@index([domain, status, effectiveFrom])
  @@map("contract_clauses")
}

model HouseholdEvent {
  id              String               @id @default(cuid())
  householdId     String               @map("household_id")
  contractCycleId String               @map("contract_cycle_id")
  memberId        String?              @map("member_id")
  issueId         String?              @map("issue_id")
  source          HouseholdEventSource
  eventType       String               @map("event_type")
  occurredAt      DateTime             @map("occurred_at")
  payload         Json
  household       Household            @relation(fields: [householdId], references: [id], onDelete: Restrict)
  contractCycle   ContractCycle        @relation(fields: [contractCycleId], references: [id], onDelete: Restrict)
  member          Member?              @relation(fields: [memberId], references: [id], onDelete: SetNull)
  issue           Issue?               @relation(fields: [issueId], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now()) @map("created_at")
  @@index([householdId, occurredAt])
  @@index([contractCycleId, occurredAt])
  @@index([memberId, occurredAt])
  @@index([issueId, occurredAt])
  @@map("household_events")
}

model Issue {
  id                 String            @id @default(cuid())
  householdId        String            @map("household_id")
  contractCycleId    String            @map("contract_cycle_id")
  memberId           String?           @map("member_id")
  reporterMessageId  String?           @unique @map("reporter_message_id")
  status             IssueStatus       @default(REPORTED)
  route              IssueRoute
  intent             String
  domain             String
  severity           String
  urgency            String
  classification     Json
  openedAt           DateTime          @map("opened_at")
  closedAt           DateTime?         @map("closed_at")
  household          Household         @relation(fields: [householdId], references: [id], onDelete: Restrict)
  contractCycle      ContractCycle     @relation(fields: [contractCycleId], references: [id], onDelete: Restrict)
  member             Member?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
  reporterMessage    ConversationMessage? @relation("IssueReporterMessage", fields: [reporterMessageId], references: [id], onDelete: SetNull)
  events             HouseholdEvent[]
  tickets            ActionTicket[]
  modelRuns          ModelRun[]
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  @@index([householdId, status, openedAt])
  @@index([contractCycleId, status])
  @@index([memberId, openedAt])
  @@map("issues")
}

model ModelRun {
  id                    String         @id @default(cuid())
  issueId               String?        @map("issue_id")
  task                  String
  provider              String
  model                 String?
  status                ModelRunStatus
  promptTemplateKey     String         @map("prompt_template_key")
  promptTemplateVersion Int            @map("prompt_template_version")
  providerPromptId      String?        @map("provider_prompt_id")
  providerPromptVersion String?        @map("provider_prompt_version")
  providerResponseId    String?        @map("provider_response_id")
  inputHash             String         @map("input_hash")
  output                Json?
  errorCode             String?        @map("error_code")
  latencyMs             Int?           @map("latency_ms")
  inputTokens           Int?           @map("input_tokens")
  outputTokens          Int?           @map("output_tokens")
  issue                 Issue?         @relation(fields: [issueId], references: [id], onDelete: SetNull)
  createdAt             DateTime       @default(now()) @map("created_at")
  @@index([issueId, createdAt])
  @@index([task, status, createdAt])
  @@map("model_runs")
}

model ActionTicket {
  id          String             @id @default(cuid())
  issueId     String             @map("issue_id")
  status      ActionTicketStatus @default(OPEN)
  queue       String
  dueAt       DateTime           @map("due_at")
  assignedTo String?            @map("assigned_to")
  issue       Issue              @relation(fields: [issueId], references: [id], onDelete: Restrict)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  @@index([issueId, status])
  @@index([status, dueAt])
  @@map("action_tickets")
}

model ChannelIdentityLink {
  id                 String             @id @default(cuid())
  provider           String             @default("KAKAO")
  providerUserKeyHash String            @map("provider_user_key_hash")
  memberId           String             @map("member_id")
  householdId        String             @map("household_id")
  contractCycleId    String             @map("contract_cycle_id")
  role               MemberRole
  status             IdentityLinkStatus @default(ACTIVE)
  reachability       KakaoReachability   @default(UNKNOWN)
  verifiedAt         DateTime            @map("verified_at")
  revokedAt          DateTime?           @map("revoked_at")
  member             Member              @relation(fields: [memberId], references: [id], onDelete: Restrict)
  household          Household           @relation(fields: [householdId], references: [id], onDelete: Restrict)
  contractCycle      ContractCycle       @relation(fields: [contractCycleId], references: [id], onDelete: Restrict)
  conversation       Conversation?
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  @@unique([provider, providerUserKeyHash, contractCycleId])
  @@index([memberId, status])
  @@index([householdId, contractCycleId, status])
  @@map("channel_identity_links")
}

model Conversation {
  id                    String               @id @default(cuid())
  householdId           String               @map("household_id")
  contractCycleId       String               @map("contract_cycle_id")
  memberId              String               @map("member_id")
  channelIdentityLinkId String?              @unique @map("channel_identity_link_id")
  channel               ConversationChannel
  status                ConversationStatus   @default(ACTIVE)
  lastMessageAt         DateTime              @map("last_message_at")
  household             Household            @relation(fields: [householdId], references: [id], onDelete: Restrict)
  contractCycle         ContractCycle        @relation(fields: [contractCycleId], references: [id], onDelete: Restrict)
  member                Member               @relation(fields: [memberId], references: [id], onDelete: Restrict)
  channelIdentityLink   ChannelIdentityLink? @relation(fields: [channelIdentityLinkId], references: [id], onDelete: SetNull)
  messages              ConversationMessage[]
  flows                 FlowInstance[]
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  @@index([householdId, lastMessageAt])
  @@index([contractCycleId, status])
  @@index([memberId, lastMessageAt])
  @@map("conversations")
}

model ConversationMessage {
  id                String                 @id @default(cuid())
  conversationId    String                 @map("conversation_id")
  direction         MessageDirection
  kind              MessageKind            @default(TEXT)
  body              String
  accessLevel       InformationAccessLevel @default(A) @map("access_level")
  providerMessageId String?                @map("provider_message_id")
  replyToMessageId  String?                @map("reply_to_message_id")
  conversation      Conversation           @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  replyToMessage    ConversationMessage?   @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies           ConversationMessage[]  @relation("MessageReplies")
  reportedIssue     Issue?                 @relation("IssueReporterMessage")
  createdAt         DateTime               @default(now()) @map("created_at")
  @@unique([conversationId, providerMessageId])
  @@index([conversationId, createdAt])
  @@index([replyToMessageId])
  @@map("conversation_messages")
}

model ContractFinancialTerms {
  id               String                 @id
  contractCycleId  String                 @map("contract_cycle_id")
  depositKrw       Int                    @map("deposit_krw")
  monthlyRentKrw   Int                    @map("monthly_rent_krw")
  serviceFeeKrw    Int                    @map("service_fee_krw")
  utilityFixedKrw  Int                    @map("utility_fixed_krw")
  regularTotalKrw  Int                    @map("regular_total_krw")
  paymentDay       Int                    @map("payment_day")
  status           StructuredRecordStatus @default(DRAFT)
  effectiveFrom    DateTime               @db.Date @map("effective_from")
  effectiveTo      DateTime?              @db.Date @map("effective_to")
  sourceDocumentKey String                @map("source_document_key")
  sourceLocator    String                 @map("source_locator")
  contractCycle    ContractCycle          @relation(fields: [contractCycleId], references: [id], onDelete: Restrict)
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  @@unique([contractCycleId, effectiveFrom])
  @@index([contractCycleId, status, effectiveFrom])
  @@map("contract_financial_terms")
}

model PaymentSchedule {
  id              String                @id
  contractCycleId String                @map("contract_cycle_id")
  periodStart     DateTime              @db.Date @map("period_start")
  periodEnd       DateTime              @db.Date @map("period_end")
  dueDate         DateTime              @db.Date @map("due_date")
  amountKrw       Int                   @map("amount_krw")
  status          PaymentScheduleStatus @default(SCHEDULED)
  paidAt          DateTime?             @db.Timestamptz(3) @map("paid_at")
  contractCycle   ContractCycle         @relation(fields: [contractCycleId], references: [id], onDelete: Restrict)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  @@unique([contractCycleId, dueDate])
  @@index([contractCycleId, status, dueDate])
  @@map("payment_schedules")
}

model KnowledgeRecord {
  id                String                 @id
  householdId       String                 @map("household_id")
  contractCycleId   String                 @map("contract_cycle_id")
  kind              KnowledgeKind
  category          String
  key               String
  structuredValue   Json                   @map("structured_value")
  answerText        String                 @map("answer_text")
  accessLevel       InformationAccessLevel @default(A) @map("access_level")
  status            StructuredRecordStatus @default(DRAFT)
  effectiveFrom     DateTime               @db.Date @map("effective_from")
  effectiveTo       DateTime?              @db.Date @map("effective_to")
  sourceDocumentKey String                 @map("source_document_key")
  sourceLocator     String                 @map("source_locator")
  household         Household              @relation(fields: [householdId], references: [id], onDelete: Restrict)
  contractCycle     ContractCycle          @relation(fields: [contractCycleId], references: [id], onDelete: Restrict)
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  @@unique([contractCycleId, category, key, effectiveFrom])
  @@index([contractCycleId, kind, category, status, effectiveFrom])
  @@index([householdId, status, effectiveFrom])
  @@map("knowledge_records")
}

model CheckinTemplate {
  id          String                 @id
  key         String
  version     Int
  title       String
  questions  Json
  status      StructuredRecordStatus @default(DRAFT)
  schedules   CheckinSchedule[]
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  @@unique([key, version])
  @@index([key, status, version])
  @@map("checkin_templates")
}

model CheckinSchedule {
  id              String                @id
  householdId     String                @map("household_id")
  contractCycleId String                @map("contract_cycle_id")
  memberId        String                @map("member_id")
  templateId      String                @map("template_id")
  stage           CheckinStage
  scheduledFor    DateTime              @db.Timestamptz(3) @map("scheduled_for")
  status          CheckinScheduleStatus @default(SCHEDULED)
  isDemo          Boolean               @default(false) @map("is_demo")
  household       Household             @relation(fields: [householdId], references: [id], onDelete: Restrict)
  contractCycle   ContractCycle         @relation(fields: [contractCycleId], references: [id], onDelete: Restrict)
  member          Member                @relation(fields: [memberId], references: [id], onDelete: Restrict)
  template        CheckinTemplate       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  flow            FlowInstance?
  response        CheckinResponse?
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  @@unique([contractCycleId, memberId, stage, scheduledFor])
  @@index([memberId, status, scheduledFor])
  @@index([householdId, status, scheduledFor])
  @@index([templateId])
  @@map("checkin_schedules")
}

model FlowInstance {
  id                String         @id @default(cuid())
  householdId       String         @map("household_id")
  contractCycleId   String         @map("contract_cycle_id")
  memberId          String         @map("member_id")
  conversationId    String?        @map("conversation_id")
  checkinScheduleId String?        @unique @map("checkin_schedule_id")
  type              FlowType
  status            FlowStatus     @default(IN_PROGRESS)
  stepKey           String         @map("step_key")
  context           Json
  version           Int            @default(1)
  expiresAt         DateTime       @db.Timestamptz(3) @map("expires_at")
  household         Household      @relation(fields: [householdId], references: [id], onDelete: Restrict)
  contractCycle     ContractCycle  @relation(fields: [contractCycleId], references: [id], onDelete: Restrict)
  member            Member         @relation(fields: [memberId], references: [id], onDelete: Restrict)
  conversation      Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  checkinSchedule   CheckinSchedule? @relation(fields: [checkinScheduleId], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  @@index([contractCycleId, memberId, status])
  @@index([conversationId, status])
  @@index([status, expiresAt])
  @@map("flow_instances")
}

model CheckinResponse {
  id                 String             @id @default(cuid())
  checkinScheduleId  String             @unique @map("checkin_schedule_id")
  respondentMemberId String             @map("respondent_member_id")
  answers            Json
  freeText           String?            @map("free_text")
  disposition        CheckinDisposition
  completedAt        DateTime           @db.Timestamptz(3) @map("completed_at")
  checkinSchedule    CheckinSchedule    @relation(fields: [checkinScheduleId], references: [id], onDelete: Restrict)
  respondentMember   Member             @relation(fields: [respondentMemberId], references: [id], onDelete: Restrict)
  createdAt          DateTime           @default(now()) @map("created_at")
  @@index([respondentMemberId, completedAt])
  @@map("checkin_responses")
}

model ChannelLinkingToken {
  id              String             @id @default(cuid())
  tokenHash       String             @unique @map("token_hash")
  memberId        String             @map("member_id")
  contractCycleId String             @map("contract_cycle_id")
  status          LinkingTokenStatus @default(ACTIVE)
  expiresAt       DateTime           @map("expires_at")
  usedAt          DateTime?          @map("used_at")
  member          Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  contractCycle   ContractCycle      @relation(fields: [contractCycleId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now()) @map("created_at")
  @@index([memberId, status, expiresAt])
  @@map("channel_linking_tokens")
}

model ProviderEventReceipt {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String   @map("provider_event_id")
  householdId     String?  @map("household_id")
  eventType       String   @map("event_type")
  receivedAt      DateTime @default(now()) @map("received_at")
  @@unique([provider, providerEventId, eventType])
  @@map("provider_event_receipts")
}

model AuditLog {
  id          String   @id @default(cuid())
  event       String
  actorId     String?  @map("actor_id")
  householdId String?  @map("household_id")
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  payload     Json
  createdAt   DateTime @default(now()) @map("created_at")
  @@index([householdId, createdAt])
  @@index([entityType, entityId])
  @@map("checkin_router_audit_logs")
}
