CHECKIN_AUTO_SEND=false
INBOUND_AUTO_REPLY=false
QUESTION_AUTO_ACTIVATE=false
FAQ_AUTO_ACTIVATE=false
PARTNER_AUTO_DISPATCH=false
DIRECT_DEAL_AUTO_ACTION=false
HUMAN_REVIEW_REQUIRED=true
